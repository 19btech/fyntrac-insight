# Backend environment variables
PORT=4000

# MongoDB base URI — the database name is substituted per-tenant automatically:
#   Metadata DB : FYNTRAC_INSIGHT_<TENANT>  (dashboards, questions, collections, etc.)
#   Data DB     : FYNTRAC_DATA_<TENANT>     (Fyntrac financial data — read-only queries)
# Provide only the base URI (without a database name, or with any placeholder db).
MONGODB_URI=mongodb://localhost:27017/fyntrac_insight_master

# Target MongoDB data source (base URI — db name substituted per-tenant)
TARGET_MONGODB_URI=mongodb://localhost:27017/fyntrac_data_master

# ── SSO / Authentication ──────────────────────────────────────────────────────
# ZITADEL (preferred) — set both vars to enable JWKS-based RS256 validation.
# These are populated by the global fyntrac startup environment.
ZITADEL_ISSUER_URI=${ZITADEL_ISSUER_URI}
ZITADEL_PROJECT_ID=${ZITADEL_PROJECT_ID}

# Legacy static public key (used only if ZITADEL_ISSUER_URI is not set).
# Multi-line: escape newlines as \n in the .env file.
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Dev bypass — set to "true" to skip ALL auth checks locally. NEVER use in production.
# SKIP_AUTH=true

# Anthropic API key for AI features
ANTHROPIC_API_KEY=sk-ant-...

# Query result cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Allowed CORS origins for the frontend (comma-separated)
CORS_ORIGIN=http://localhost:3000

# Email / SMTP settings for alert notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@fyntrac.com
SMTP_PASS=your-smtp-password
SMTP_FROM=analytics@fyntrac.com

# Tenant isolation strategy:
#   field    - every document has a tenantId field (default; multi-tenant DB)
#   database - the database itself is the tenant boundary (single-tenant DB)
TENANT_ISOLATION=field
