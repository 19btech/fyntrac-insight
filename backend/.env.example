# Backend environment variables
PORT=4000

# MongoDB metadata store (dashboards, questions, collections metadata)
MONGODB_URI=mongodb://localhost:27017/fyntrac_analytics_meta

# Target MongoDB data source (read-only)
TARGET_MONGODB_URI=mongodb://localhost:27017/fyntrac_data

# RS256 public key from Fyntrac main app (multi-line: escape newlines as \n)
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Anthropic API key for AI features
ANTHROPIC_API_KEY=sk-ant-...

# Query result cache TTL in seconds (default: 300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Allowed CORS origin for the frontend
CORS_ORIGIN=http://localhost:3000

# Email / SMTP settings for alert notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@fyntrac.com
SMTP_PASS=your-smtp-password
SMTP_FROM=analytics@fyntrac.com

# Tenant isolation strategy:
#   field    - every document has a tenantId field (default; multi-tenant DB)
#   database - the database itself is the tenant boundary (single-tenant DB)
TENANT_ISOLATION=field
